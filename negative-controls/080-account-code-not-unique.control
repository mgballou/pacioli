# Without UNIQUE on code, one code opens twice and a balance read picks a row at random.

title: an account code is not unique and the same code opens twice
file: internal/schema/0001_ledger.sql
run: make db-reset && go test -count=1 -run TestOpeningACodeTwiceIsAConflict -v ./internal/ledgerhttp/
--- before
    code       text NOT NULL UNIQUE CHECK (code ~ '^[a-z][a-z0-9_.]*$'),
--- after
    -- negative control: two accounts may hold one code
    code       text NOT NULL CHECK (code ~ '^[a-z][a-z0-9_.]*$'),
